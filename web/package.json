{
  "name": "skinnycat",
  "version": "0.1.0",
  "private": true,
  "description": "skinnycat.classix.dev, an educational demo of quantum-secure payments on Ethereum Classic with leanSPHINCS keys in the browser, not a production app",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-contracts.mjs && node scripts/extract-vectors.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "icons": "node --experimental-strip-types --no-warnings scripts/icons.mjs",
    "test": "vitest run",
    "test:e2e": "bash e2e/run.sh",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scure/bip39": "^2.4.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
