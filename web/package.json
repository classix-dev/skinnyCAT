{
  "name": "pq-classix",
  "version": "0.1.0",
  "private": true,
  "description": "pq.classix.dev, a leanSPHINCS-controlled wallet on Ethereum Classic in the browser",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-contracts.mjs && node scripts/extract-vectors.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
