    "preview": "vite preview",
    "test:e2e": "bash e2e/run.sh"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "viem": "^2.57.17"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  }
}
