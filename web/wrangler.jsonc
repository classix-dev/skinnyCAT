{
  // pq.classix.dev, a static site served by a Worker with static assets.
  // Build first (npm run build), then deploy with wrangler from this folder.
  "name": "pq-classix",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "pq.classix.dev", "custom_domain": true }]
}
